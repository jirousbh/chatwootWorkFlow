# Arquivo de exemplo de configuração para backup na nuvem
# Copie este arquivo para cloud-backup.conf e configure com suas credenciais

# Provedor de nuvem (aws_s3, google_cloud, backblaze_b2, digitalocean_spaces)
PROVIDER=aws_s3

# Para AWS S3
BUCKET_NAME=meu-bucket-chatwoot
REGION=us-east-1
ACCESS_KEY=sua_access_key_aqui
SECRET_KEY=sua_secret_key_aqui
ENDPOINT_URL=https://s3.us-east-1.amazonaws.com

# Para Google Cloud Storage
# PROVIDER=google_cloud
# BUCKET_NAME=meu-bucket-chatwoot
# PROJECT_ID=meu-projeto-gcp

# Para Google Drive
# PROVIDER=google_drive
# FOLDER_NAME=Chatwoot_Backups
# CREDENTIALS_FILE=/caminho/para/credenciais.json

# Para OneDrive
# PROVIDER=onedrive
# FOLDER_NAME=Chatwoot_Backups
# AUTH_METHOD=password
# EMAIL=seu_email@outlook.com
# PASSWORD=sua_senha

# Para OneDrive (com token)
# PROVIDER=onedrive
# FOLDER_NAME=Chatwoot_Backups
# AUTH_METHOD=token
# ACCESS_TOKEN=seu_token_aqui

# Para Backblaze B2
# PROVIDER=backblaze_b2
# BUCKET_NAME=meu-bucket-chatwoot
# KEY_ID=sua_application_key_id
# APPLICATION_KEY=sua_application_key
# ENDPOINT_URL=https://s3.us-west-002.backblazeb2.com

# Para DigitalOcean Spaces
# PROVIDER=digitalocean_spaces
# SPACE_NAME=meu-space-chatwoot
# REGION=nyc3
# ACCESS_KEY=sua_access_key
# SECRET_KEY=sua_secret_key
# ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
